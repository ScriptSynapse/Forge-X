# =====================================================================
# FORGE-X backend — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (the frontend's URL)
CORS_ORIGIN=http://localhost:5173

# --- MySQL connection (points at the SAME forge_x database built in
#     Steps 1-5 — this backend does not create or use a second database) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=forgex_app
DB_PASSWORD=change_me
DB_NAME=forge_x
DB_CONNECTION_LIMIT=10

# --- Auth ---
# Generate a real secret with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12
