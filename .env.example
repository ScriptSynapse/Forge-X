# Copy this file to .env and fill in real values. Never commit .env.

# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FORGE_X_SECRET_KEY=replace-with-64-hex-characters

# MySQL (use the least-privilege account from database/app_user.sql, never root)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=forge_x_db
MYSQL_USER=forge_x_app
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5

# Lab local time (decision D1)
DB_TIME_ZONE=+05:30

# Set to 1 only when the app is served over HTTPS
SESSION_COOKIE_SECURE=0

# --- Hosting through Cloudflare Tunnel (docs/DEPLOY_CLOUDFLARE.md) ---
# Production server address. Keep 127.0.0.1 so only cloudflared can reach the app.
FORGE_X_HOST=127.0.0.1
FORGE_X_PORT=8000
# Set to 1 ONLY when the app is served through Cloudflare Tunnel.
TRUST_CLOUDFLARE=0
