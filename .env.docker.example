# FORGE-X Docker settings. Copy to .env.docker (never commit it) and change EVERY value:
#   copy .env.docker.example .env.docker
# Generate a secret key with:  python -c "import secrets; print(secrets.token_hex(32))"

FORGE_X_SECRET_KEY=de8cfd8496fb727bd6ac8b4eb1145a3889bc38427bde9608e936bb7e03961aee
FORGE_X_DB_ROOT_PASSWORD=mysql
# Letters, digits and - _ . only (no quotes or backslashes).
FORGE_X_DB_APP_PASSWORD=mysql26

# The app is published on 127.0.0.1 only.
FORGE_X_PUBLISH_PORT=8000
# 1 when served over HTTPS (for example behind a reverse proxy).
SESSION_COOKIE_SECURE=0
EVIDENCE_MAX_MB=100

# Optional MinIO (start with --profile s3). Set EVIDENCE_STORAGE_BACKEND=s3 to store new files there.
EVIDENCE_STORAGE_BACKEND=local
MINIO_ROOT_USER=forgex-minio
# Letters and digits only (they are also used inside a URL).
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=forgex-evidence
